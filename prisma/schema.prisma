  @@index([shop, analysisDepth, riskScore])
  @@index([shop, isResolved, riskScore])
  @@index([shop, isWatched, riskScore])
  @@index([shop, vendor])
  @@index([shop, productType])
}

model ProductDiagnosis {
  id              String          @id @default(cuid())
  shop            String
  productGid      String
  productTitle    String
  status          String
  riskScore       Int
  confidence      Int
  likelyCause     String
  issues          Json
  evidence        Json
  recommendations Json
  metrics         Json?
  creditsConsumed Int             @default(1)
  createdAt       DateTime        @default(now())
  completedAt     DateTime?
  actions         ProductAction[]

  @@index([shop, status])
  @@index([shop, productGid])
  @@index([shop, status, productGid, completedAt, createdAt])
}

model ProductRetentionRun {
  id               String   @id @default(cuid())
  shopId           String
  productGid       String
  diagnosisId      String
  asOfDate         DateTime
  timezone         String
  windowStartDate  DateTime
  windowEndDate    DateTime
  lookbackDays     Int
  maxCohortAgeDays Int
  currency         String?
  schemaVersion    Int
  status           String
  errorMessage     String?
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([shopId, productGid, diagnosisId])
  @@index([shopId, productGid, asOfDate])
  @@index([diagnosisId])
}

model ProductRetentionDailyCohort {
  id                                String   @id @default(cuid())
  shopId                            String
  productGid                        String
