// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ProductPulseSource {
  id             String    @id @default(cuid())
  shop           String
  sourceKey      String
  category       String
  name           String
  connected      Boolean   @default(false)
  active         Boolean   @default(true)
  ignored        Boolean   @default(false)
  available      Boolean   @default(false)
  health         String    @default("not_connected")
  coverageWeight Int
  config         Json?
  credentials    Json?
  connectedAt    DateTime?
  disabledAt     DateTime?
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([shop, sourceKey])
  @@index([shop])
}

model CatalogSignalJob {
  id           String    @id @default(cuid())
  shop         String
  kind         String
  source       String
  status       String
  progress     Int       @default(0)
  payload      Json?
  errorMessage String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([shop, status])
  @@index([shop, kind, status])
  @@index([kind, status, startedAt])
}

model ProductPulseAiProviderState {
  id                 String    @id @default(cuid())
  provider           String    @unique
  currentModel       String
  lastPrimaryRetryAt DateTime?
  failureCount       Int       @default(0)
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model AiConversation {
  id        String                  @id @default(cuid())
  shop      String
  userId    String?
  title     String?
  metadata  Json?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  messages  AiConversationMessage[]
  toolCalls AiConversationToolCall[]

  @@index([shop, updatedAt])
  @@index([shop, userId])
}

model AiConversationMessage {
  id                String                   @id @default(cuid())
  shop              String
  conversationId    String
  conversation      AiConversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role              String
  content           String
  structuredContent Json?
  openAiResponseId  String?
  createdAt         DateTime                 @default(now())
  toolCalls         AiConversationToolCall[]

  @@index([shop, conversationId, createdAt])
  @@index([conversationId, createdAt])
}

model AiConversationToolCall {
  id             String                 @id @default(cuid())
  shop           String
  conversationId String
  conversation   AiConversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        AiConversationMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  toolName       String
  callId         String?
  validatedInput Json?
  status         String
  durationMs     Int?
  resultCount    Int?
  safeError      Json?
  createdAt      DateTime               @default(now())

  @@index([shop, conversationId, createdAt])
  @@index([conversationId, toolName])
  @@index([messageId])
}

model AiUsageEvent {
  id                String   @id @default(cuid())
  shop              String
  userId            String?
  source            String
  operation         String
  provider          String
  model             String
  task              String?
  requestContext    String?
  conversationId    String?
  messageId         String?
  jobId             String?
  entityType        String?
  entityId          String?
  status            String   @default("success")
  usage             Json?
  inputTokens       Int?
  outputTokens      Int?
  cachedInputTokens Int?
  reasoningTokens   Int?
  totalTokens       Int?
  estimatedCost     Json?
  estimatedTotalUsd Float?
  createdAt         DateTime @default(now())

  @@index([shop, createdAt])
  @@index([shop, source, createdAt])
  @@index([shop, provider, model])
  @@index([shop, conversationId, createdAt])
  @@index([shop, jobId, createdAt])
}

model AiActionProposal {
  id                           String             @id @default(cuid())
  shop                         String
  userId                       String?
  conversationId               String?
  actionName                   String
  category                     String
  targetType                   String
  targetId                     String
  targetLabel                  String?
  proposedInput                Json
  title                        String
  summary                      String
  reason                       String?
  expectedResult               String?
  risks                        Json?
  confirmationLevel            String
  sideEffectLevel              String
  reversible                   Boolean            @default(false)
  requiresEntityOwnershipCheck Boolean            @default(true)
  status                       String             @default("pending")
  result                       Json?
  safeError                    Json?
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt
  expiresAt                    DateTime
  confirmedAt                  DateTime?
  cancelledAt                  DateTime?
  executedAt                   DateTime?
  auditLogs                    AiActionAuditLog[]

  @@index([shop, status, expiresAt])
  @@index([shop, conversationId, createdAt])
  @@index([shop, actionName, createdAt])
  @@index([shop, targetType, targetId])
}

model AiActionAuditLog {
  id             String            @id @default(cuid())
  shop           String
  userId         String?
  conversationId String?
  proposalId     String?
  proposal       AiActionProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  actionName     String
  targetType     String?
  targetId       String?
  eventType      String
  validatedInput Json?
  status         String
  durationMs     Int?
  safeSummary    String?
  safeError      Json?
  createdAt      DateTime          @default(now())

  @@index([shop, createdAt])
  @@index([shop, proposalId, createdAt])
  @@index([shop, actionName, createdAt])
  @@index([proposalId])
}

model AiAppDraftProposal {
  id                      String                @id @default(cuid())
  shop                    String
  userId                  String?
  conversationId          String?
  mutationName            String
  category                String
  targetType              String
  targetId                String
  targetLabel             String?
  draftType               String
  sourceContext           Json?
  currentAppValueSnapshot Json?
  proposedValue           Json
  userEditedValue         Json?
  finalDraftValue         Json?
  generatedReason         String?
  evidenceReferences      Json?
  validationWarnings      Json?
  title                   String
  summary                 String
  editableFields          Json?
  proposedInput           Json
  confirmationLevel       String
  sideEffectLevel         String
  reversible              Boolean               @default(true)
  allowedFields           Json?
  blockedFields           Json?
  status                  String                @default("draft")
  safeError               Json?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  expiresAt               DateTime
  savedAt                 DateTime?
  cancelledAt             DateTime?
  auditLogs               AiAppDraftAuditLog[]

  @@index([shop, status, expiresAt])
  @@index([shop, conversationId, createdAt])
  @@index([shop, mutationName, createdAt])
  @@index([shop, targetType, targetId])
}

model AiAppDraftAuditLog {
  id             String              @id @default(cuid())
  shop           String
  userId         String?
  conversationId String?
  proposalId     String?
  proposal       AiAppDraftProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  mutationName   String
  category       String
  targetType     String?
  targetId       String?
  eventType      String
  validatedInput Json?
  status         String
  durationMs     Int?
  safeSummary    String?
  safeError      Json?
  createdAt      DateTime            @default(now())

  @@index([shop, createdAt])
  @@index([shop, proposalId, createdAt])
  @@index([shop, mutationName, createdAt])
  @@index([proposalId])
}

model ProductPulseJobLog {
  id        String   @id @default(cuid())
  shop      String
  jobId     String
  level     String   @default("info")
  event     String
  message   String
  data      Json?
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
  @@index([jobId, createdAt])
}

model ProductRiskSnapshot {
  id             String   @id @default(cuid())
  shop           String
  productGid     String
  productTitle   String
  handle         String
  riskScore      Int
  impactScore    Int
  confidence     Int
  primaryIssue   String
  sourceCoverage Json
  metrics        Json
  calculatedAt   DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([shop, productGid])
  @@index([shop, riskScore])
}

model ProductDiagnosis {
  id              String          @id @default(cuid())
  shop            String
  productGid      String
  productTitle    String
  status          String
  riskScore       Int
  confidence      Int
  likelyCause     String
  issues          Json
  evidence        Json
  recommendations Json
  creditsConsumed Int             @default(1)
  createdAt       DateTime        @default(now())
  completedAt     DateTime?
  actions         ProductAction[]

  @@index([shop, status])
  @@index([shop, productGid])
}

model ProductAction {
  id          String            @id @default(cuid())
  shop        String
  diagnosisId String?
  diagnosis   ProductDiagnosis? @relation(fields: [diagnosisId], references: [id], onDelete: SetNull)
  productGid  String
  actionType  String
  label       String
  status      String            @default("draft")
  payload     Json
  createdAt   DateTime          @default(now())
  appliedAt   DateTime?

  @@index([shop, status])
  @@index([shop, productGid])
}

model ProductWatchlistItem {
  id           String   @id @default(cuid())
  shop         String
  productGid   String
  productTitle String
  handle       String?
  sku          String?
  status       String   @default("Watching")
  imageUrl     String?
  imageAlt     String?
  addedAt      DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([shop, productGid])
  @@index([shop, status])
  @@index([shop, addedAt])
}

model ProductWatchSettings {
  id              String   @id @default(cuid())
  shop            String   @unique
  scanCadenceDays Int      @default(3)
  alertRecipients Json?
  triggerRule     String   @default("new_or_rising_risk")
  summarySchedule String   @default("daily_digest_8am")
  alertsEnabled   Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([shop])
}

model ProductWatchActivity {
  id              String   @id @default(cuid())
  shop            String
  productGid      String?
  productTitle    String?
  watchlistItemId String?
  eventType       String
  title           String
  detail          String?
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([shop, createdAt])
  @@index([shop, productGid, createdAt])
  @@index([shop, eventType])
}

model ProductPulseSchedulerLock {
  key        String   @id
  owner      String
  acquiredAt DateTime @default(now())
  expiresAt  DateTime
  updatedAt  DateTime @updatedAt

  @@index([expiresAt])
}

model ProductScoreHistory {
  id           String   @id @default(cuid())
  shop         String
  productGid   String
  productTitle String
  handle       String?
  source       String
  riskScore    Int
  impactScore  Int?
  confidence   Int?
  primaryIssue String?
  metrics      Json?
  snapshotId   String?
  diagnosisId  String?
  recordedAt   DateTime @default(now())

  @@index([shop, productGid, recordedAt])
  @@index([shop, recordedAt])
  @@index([shop, source])
}

model ContactRequest {
  id        String   @id @default(cuid())
  shop      String
  type      String
  subject   String
  message   String
  email     String?
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
}

model CreditLedgerEntry {
  id           String   @id @default(cuid())
  shop         String
  direction    String
  amount       Int
  reason       String
  balanceAfter Int
  createdAt    DateTime @default(now())

  @@index([shop, createdAt])
}
