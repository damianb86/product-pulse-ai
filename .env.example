PRODUCT_PULSE_JOB_LEASE_TTL_MS=600000
PRODUCT_PULSE_JOB_HEARTBEAT_MS=60000
PRODUCT_PULSE_WORKER_IDLE_SLEEP_MS=5000
PRODUCT_PULSE_WORKER_MAX_JOBS_PER_CYCLE=1
