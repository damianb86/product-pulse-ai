  diagnosisId String?
  diagnosis   ProductDiagnosis? @relation(fields: [diagnosisId], references: [id], onDelete: SetNull)
  productGid  String
  actionType  String
  label       String
  status      String            @default("draft")
  payload     Json
  createdAt   DateTime          @default(now())
  appliedAt   DateTime?

  @@index([shop, status])
  @@index([shop, productGid])
  @@index([shop, status, actionType, productGid, appliedAt, createdAt])
}

