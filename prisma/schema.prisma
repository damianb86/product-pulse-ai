  judgeMeReviewCount         Int       @default(0)
  judgeMeNegativeReviewCount Int       @default(0)
  judgeMeAverageRating       Float     @default(0)
  yotpoReviewCount           Int       @default(0)
  looxReviewCount            Int       @default(0)
  productMomentumScore       Int?
