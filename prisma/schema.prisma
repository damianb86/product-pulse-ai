  refundAmount               Float     @default(0)
  avgUnitRevenue             Float     @default(0)
  marginRate                 Float?
  returnRate                 Float     @default(0)
  refundRate                 Float     @default(0)
  returnUnits                Int       @default(0)
  refundUnits                Int       @default(0)
  recentSignalUnits          Int       @default(0)
  windowDays                 Int       @default(60)
  soldUnits                  Int       @default(0)
  soldOrders                 Int       @default(0)
  storeAvgReturnRate         Float     @default(0)
  storeAvgRefundRate         Float     @default(0)
