PRODUCT_RETENTION_MAX_ORDER_PAGES=80
PRODUCT_RETENTION_LINE_ITEMS_PAGE_SIZE=100
PRODUCT_RETENTION_REFUND_LINE_ITEMS_PAGE_SIZE=100
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Docker/deployment placeholders
COMPOSE_PROJECT_NAME=product-pulse-ai
SHARED_DOCKER_NETWORK=shared_apps
APP_DB_NAME=product_pulse_ai
APP_DB_USER=zuam_dev
APP_DB_PASSWORD=replace-with-local-password
APP_HOST=product-pulse-ai.example.com
# For Docker deployments, set DATABASE_URL to the shared PostgreSQL service:
# DATABASE_URL=postgresql://zuam_dev:replace-with-local-password@postgres:5432/product_pulse_ai?schema=public&connection_limit=10&pool_timeout=30
# In Docker, the app service disables inline workers by default and the worker service runs npm run worker.
# PRODUCT_PULSE_INLINE_WORKERS_ENABLED=false
CONTACT_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
NODE_OPTIONS=
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5
