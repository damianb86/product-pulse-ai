// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ProductPulseSource {
  id             String    @id @default(cuid())
  shop           String
  sourceKey      String
  category       String
  name           String
  connected      Boolean   @default(false)
  active         Boolean   @default(true)
  ignored        Boolean   @default(false)
  available      Boolean   @default(false)
  health         String    @default("not_connected")
  coverageWeight Int
  config         Json?
  credentials    Json?
  connectedAt    DateTime?
  disabledAt     DateTime?
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([shop, sourceKey])
  @@index([shop])
}

model CatalogSignalJob {
  id           String    @id @default(cuid())
  shop         String
  kind         String
  source       String
  status       String
  progress     Int       @default(0)
  payload      Json?
  errorMessage String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([shop, status])
  @@index([shop, kind, status])
  @@index([kind, status, startedAt])
}

model ProductPulseAiProviderState {
  id                 String    @id @default(cuid())
  provider           String    @unique
  currentModel       String
  lastPrimaryRetryAt DateTime?
  failureCount       Int       @default(0)
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model ProductPulseJobLog {
  id        String   @id @default(cuid())
  shop      String
  jobId     String
  level     String   @default("info")
  event     String
  message   String
  data      Json?
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
  @@index([jobId, createdAt])
}

model ProductRiskSnapshot {
  id             String   @id @default(cuid())
  shop           String
  productGid     String
  productTitle   String
  handle         String
  riskScore      Int
  impactScore    Int
  confidence     Int
  primaryIssue   String
  sourceCoverage Json
  metrics        Json
  calculatedAt   DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([shop, productGid])
  @@index([shop, riskScore])
}

model ProductDiagnosis {
  id              String          @id @default(cuid())
  shop            String
  productGid      String
  productTitle    String
  status          String
  riskScore       Int
  confidence      Int
  likelyCause     String
  issues          Json
  evidence        Json
  recommendations Json
  creditsConsumed Int             @default(1)
  createdAt       DateTime        @default(now())
  completedAt     DateTime?
  actions         ProductAction[]

  @@index([shop, status])
  @@index([shop, productGid])
}

model ProductAction {
  id          String            @id @default(cuid())
  shop        String
  diagnosisId String?
  diagnosis   ProductDiagnosis? @relation(fields: [diagnosisId], references: [id], onDelete: SetNull)
  productGid  String
  actionType  String
  label       String
  status      String            @default("draft")
  payload     Json
  createdAt   DateTime          @default(now())
  appliedAt   DateTime?

  @@index([shop, status])
  @@index([shop, productGid])
}

model ProductWatchlistItem {
  id           String   @id @default(cuid())
  shop         String
  productGid   String
  productTitle String
  handle       String?
  sku          String?
  status       String   @default("Watching")
  imageUrl     String?
  imageAlt     String?
  addedAt      DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([shop, productGid])
  @@index([shop, status])
  @@index([shop, addedAt])
}

model ProductWatchActivity {
  id              String   @id @default(cuid())
  shop            String
  productGid      String?
  productTitle    String?
  watchlistItemId String?
  eventType       String
  title           String
  detail          String?
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([shop, createdAt])
  @@index([shop, productGid, createdAt])
  @@index([shop, eventType])
}

model ProductScoreHistory {
  id           String   @id @default(cuid())
  shop         String
  productGid   String
  productTitle String
  handle       String?
  source       String
  riskScore    Int
  impactScore  Int?
  confidence   Int?
  primaryIssue String?
  metrics      Json?
  snapshotId   String?
  diagnosisId  String?
  recordedAt   DateTime @default(now())

  @@index([shop, productGid, recordedAt])
  @@index([shop, recordedAt])
  @@index([shop, source])
}

model ContactRequest {
  id        String   @id @default(cuid())
  shop      String
  type      String
  subject   String
  message   String
  email     String?
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
}

model CreditLedgerEntry {
  id           String   @id @default(cuid())
  shop         String
  direction    String
  amount       Int
  reason       String
  balanceAfter Int
  createdAt    DateTime @default(now())

  @@index([shop, createdAt])
}
