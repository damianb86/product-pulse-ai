  sameProductCumulativeLtvCents      BigInt   @default(0)
  otherProductCumulativeLtvCents     BigInt   @default(0)
  isObserved                         Boolean  @default(false)
  createdAt                          DateTime @default(now())
  updatedAt                          DateTime @updatedAt

  @@unique([shopId, productGid, diagnosisId, cohortDate, ageDay])
  @@index([retentionRunId])
  @@index([shopId, productGid, cohortDate])
}

