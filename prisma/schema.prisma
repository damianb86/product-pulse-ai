  riskScore                  Int       @default(0)
  impactScore                Int       @default(0)
  confidence                 Int       @default(0)
  primaryIssue               String?
  sourceCoverage             Json?
  sourceCount                Int       @default(0)
  signalCount                Int       @default(0)
  analysisDepth              String    @default("quickscan")
  latestDiagnosisId          String?
  latestDiagnosisAt          DateTime?
  isResolved                 Boolean   @default(false)
  resolvedAt                 DateTime?
  isWatched                  Boolean   @default(false)
  watchlistStatus            String?
  reviewRating               Float     @default(0)
  avgRating                  Float     @default(0)
  reviewCount                Int       @default(0)
  negativeReviewCount        Int       @default(0)
  negativeReviewRate         Float     @default(0)
  recentNegativeReviewCount  Int       @default(0)
