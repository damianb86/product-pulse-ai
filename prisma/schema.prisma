  anyRepeatWithin7dCount            Int      @default(0)
  anyRepeatWithin14dCount           Int      @default(0)
  anyRepeatWithin30dCount           Int      @default(0)
  anyRepeatWithin60dCount           Int      @default(0)
  anyRepeatWithin90dCount           Int      @default(0)
  anyRepeatWithin180dCount          Int      @default(0)
  sameProductRepeatWithin7dCount    Int      @default(0)
  sameProductRepeatWithin14dCount   Int      @default(0)
  sameProductRepeatWithin30dCount   Int      @default(0)
  sameProductRepeatWithin60dCount   Int      @default(0)
  sameProductRepeatWithin90dCount   Int      @default(0)
  sameProductRepeatWithin180dCount  Int      @default(0)
  boughtOtherProductWithin7dCount   Int      @default(0)
  boughtOtherProductWithin14dCount  Int      @default(0)
  boughtOtherProductWithin30dCount  Int      @default(0)
  boughtOtherProductWithin60dCount  Int      @default(0)
  boughtOtherProductWithin90dCount  Int      @default(0)
  boughtOtherProductWithin180dCount Int      @default(0)
  nextPurchaseSameProductCount      Int      @default(0)
  nextPurchaseOtherProductCount     Int      @default(0)
  didNotReturnCount                 Int      @default(0)
  firstOrderNetRevenueCents         BigInt   @default(0)
  totalNetRevenueWithin30dCents     BigInt   @default(0)
  totalNetRevenueWithin60dCents     BigInt   @default(0)
  totalNetRevenueWithin90dCents     BigInt   @default(0)
  totalNetRevenueWithin180dCents    BigInt   @default(0)
  sameProductRevenueWithin90dCents  BigInt   @default(0)
  otherProductRevenueWithin90dCents BigInt   @default(0)
  ltv30Cents                        BigInt   @default(0)
  ltv60Cents                        BigInt   @default(0)
  ltv90Cents                        BigInt   @default(0)
  ltv180Cents                       BigInt   @default(0)
  avgDaysToNextPurchase             Decimal? @db.Decimal(12, 4)
  medianDaysToNextPurchase          Decimal? @db.Decimal(12, 4)
  avgDaysToSameProductRepurchase    Decimal? @db.Decimal(12, 4)
  medianDaysToSameProductRepurchase Decimal? @db.Decimal(12, 4)
  isMature7d                        Boolean  @default(false)
  isMature14d                       Boolean  @default(false)
  isMature30d                       Boolean  @default(false)
  isMature60d                       Boolean  @default(false)
  isMature90d                       Boolean  @default(false)
  isMature180d                      Boolean  @default(false)
  observedDays                      Int      @default(0)
