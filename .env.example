# ProductPulse AI
# Copy to .env for local development. Do not commit real secrets.
# Default local PostgreSQL bootstrap uses host 127.0.0.1, port 5432 and user qorve_dev.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://example.com
SHOPIFY_ADMIN_APP_HANDLE=product-pulse-ai
SCOPES=read_products,write_products,read_orders,read_all_orders,read_customers,read_returns,read_inventory,read_locations
DATABASE_URL=postgresql://qorve_dev:replace-with-local-password@127.0.0.1:5432/product_pulse_ai
SHOP_CUSTOM_DOMAIN=
NODE_ENV=development
PRODUCT_PULSE_AI_LEVEL=1
PRODUCT_PULSE_INITIAL_STORE_POINTS=100
PRODUCT_PULSE_CHAT_MESSAGES_PER_POINT=10
OPENAI_API_KEY=
OPENAI_BASIC_MODEL=gpt-5.4-nano
OPENAI_PRO_MODEL=gpt-5.4-mini
OPENAI_PREMIUM_MODEL=gpt-5.4
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MODEL_FALLBACK_POOL=
AI_ASSISTANT_ENABLED=true
AI_CHAT_MODEL=gpt-5.4-mini
AI_CHAT_MAX_TOOL_CALLS_PER_TURN=5
AI_CHAT_MAX_RECENT_MESSAGES=8
AI_CHAT_MAX_TOOL_RESULT_CHARACTERS=6000
AI_CHAT_MAX_OUTPUT_TOKENS=1600
AI_CHAT_MAX_STRUCTURED_RESPONSE_RETRIES=1
AI_CHAT_MAX_ACTION_PROPOSALS_PER_TURN=1
AI_CHAT_OPENAI_TIMEOUT_MS=30000
AI_COST_TRACKING_ENABLED=true
AI_DEBUG_COSTS=false
AI_DEBUG_MODE=false
AI_COST_DASHBOARD_ENABLED=false
AI_EVAL_MODE=false
AI_MODEL_PRICING_JSON=
AI_CHATKIT_ENABLED=true
AI_CHATKIT_API_URL=/api/ai/chatkit/message
AI_CHATKIT_DOMAIN_KEY=domain_pk_6a0e373140408193b67487c54e353dbd09dbeb51913073da
AI_INTERNAL_ACTIONS_ENABLED=true
AI_ACTION_CONFIRMATIONS_ENABLED=true
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_WINDOW_MS=60000
AI_CHAT_RATE_LIMIT_PER_MINUTE=20
AI_ACTION_RATE_LIMIT_PER_MINUTE=30
AI_CHATKIT_SESSION_RATE_LIMIT_PER_MINUTE=60
AI_CHATKIT_ACTION_RATE_LIMIT_PER_MINUTE=60
BETA_FEEDBACK_ENABLED=false
BETA_FEEDBACK_RECIPIENT=
PRODUCT_PULSE_WATCHLIST_CRON_TIME=03:00
PRODUCT_PULSE_WATCHLIST_CRON_TIMEZONE=UTC
PRODUCT_PULSE_WATCHLIST_CRON_WINDOW_MINUTES=120
PRODUCT_PULSE_WATCHLIST_CRON_LOCK_TTL_MINUTES=120
PRODUCT_PULSE_WATCHLIST_CRON_SECRET=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Docker/deployment placeholders
COMPOSE_PROJECT_NAME=product-pulse-ai
APP_DB_NAME=product_pulse_ai
APP_DB_USER=qorve_dev
APP_DB_PASSWORD=replace-with-local-password
APP_HOST=product-pulse-ai.example.com
CONTACT_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
NODE_OPTIONS=
