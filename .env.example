# ProductPulse AI environment configuration
# Mantener secretos reales solo en .env. No commitear valores privados.
# Cada variable queda agrupada por bloque y comentada con su uso.

# -----------------------------------------------------------------------------
# App runtime
# Modo de ejecucion de Node/React Router y limite de memoria del proceso principal.
# -----------------------------------------------------------------------------
# APP_ENV: Entorno funcional de la aplicacion; usar production en servidores reales.
APP_ENV=development

# NODE_ENV: Entorno de Node.js; controla optimizaciones de React y dependencias.
NODE_ENV=development

# NODE_OPTIONS: Opciones de Node; max-old-space-size limita RAM para evitar consumir todo el servidor.
NODE_OPTIONS=

# -----------------------------------------------------------------------------
# Shopify app and routing
# Credenciales, URLs publicas y handle usados por Shopify Admin y App Bridge.
# -----------------------------------------------------------------------------
# SHOPIFY_API_KEY: Client ID/API key publica de la app Shopify.
SHOPIFY_API_KEY=

# SHOPIFY_API_SECRET: Secreto privado de Shopify para OAuth y webhooks; nunca compartir ni commitear.
SHOPIFY_API_SECRET=

# SHOPIFY_APP_URL: URL publica principal configurada en Shopify para esta app.
SHOPIFY_APP_URL=https://app-ppa.zuam.dev

# DEV_SHOPIFY_APP_URL: URL publica o tunel usado durante desarrollo local.
DEV_SHOPIFY_APP_URL=https://localhost:3458

# PROD_SHOPIFY_APP_URL: URL canonica esperada para despliegues productivos.
PROD_SHOPIFY_APP_URL=https://product-pulse-ai.example.com

# SHOPIFY_ADMIN_APP_HANDLE: Handle de la app dentro de Shopify Admin; debe coincidir con la ruta /apps/<handle>.
SHOPIFY_ADMIN_APP_HANDLE=product-pulse-ai

# SCOPES: Permisos OAuth que la app solicita a las tiendas.
SCOPES=read_products,write_products,read_orders,read_all_orders,read_customers,read_returns,read_inventory,read_locations

# SHOP_CUSTOM_DOMAIN: Dominio custom opcional de una tienda; dejar vacio si no se usa.
SHOP_CUSTOM_DOMAIN=

# -----------------------------------------------------------------------------
# Database
# Conexion a PostgreSQL y parametros auxiliares para despliegues Docker.
# -----------------------------------------------------------------------------
# DATABASE_URL: Connection string de Prisma/PostgreSQL; en servidores chicos usar connection_limit bajo.
DATABASE_URL=postgresql://zuam_dev:replace-with-local-password@127.0.0.1:5432/product_pulse_ai

# POSTGRES_HOST: Host del servicio PostgreSQL cuando se usa bootstrap o Docker.
POSTGRES_HOST=127.0.0.1

# POSTGRES_PORT: Puerto del servicio PostgreSQL.
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Docker deployment
# Identidad del compose, red compartida, base de datos bootstrap y rotacion de logs.
# -----------------------------------------------------------------------------
# COMPOSE_PROJECT_NAME: Nombre del proyecto Docker Compose para aislar recursos.
COMPOSE_PROJECT_NAME=product-pulse-ai

# SHARED_DOCKER_NETWORK: Red Docker externa compartida con proxy u otras aplicaciones.
SHARED_DOCKER_NETWORK=shared_apps

# APP_DB_NAME: Nombre de la base que el bootstrap debe crear para la app.
APP_DB_NAME=product_pulse_ai

# APP_DB_USER: Usuario PostgreSQL que usara la aplicacion.
APP_DB_USER=zuam_dev

# APP_DB_PASSWORD: Password del usuario PostgreSQL; tratar como secreto.
APP_DB_PASSWORD=replace-with-local-password

# APP_HOST: Host publico usado por Docker/proxy para enrutar trafico a la app.
APP_HOST=product-pulse-ai.example.com

# DOCKER_LOG_MAX_SIZE: Tamano maximo por archivo de log Docker para evitar llenar disco.
DOCKER_LOG_MAX_SIZE=10m

# DOCKER_LOG_MAX_FILE: Cantidad maxima de archivos de log Docker rotados.
DOCKER_LOG_MAX_FILE=5

# -----------------------------------------------------------------------------
# Contact and email
# Correo de contacto y SMTP usado para alertas o feedback.
# -----------------------------------------------------------------------------
# CONTACT_EMAIL: Email publico de contacto; tambien puede usarse como fallback para feedback.
CONTACT_EMAIL=

# EMAIL_HOST: Host SMTP para enviar emails salientes.
EMAIL_HOST=

# EMAIL_PORT: Puerto SMTP.
EMAIL_PORT=587

# EMAIL_USER: Usuario SMTP.
EMAIL_USER=

# EMAIL_PASS: Password SMTP; tratar como secreto.
EMAIL_PASS=

# -----------------------------------------------------------------------------
# Sentry observability
# Observabilidad opcional; dejar DSNs vacios desactiva inicializacion y reduce overhead.
# -----------------------------------------------------------------------------
# SENTRY_DSN: DSN server-side de Sentry; vacio desactiva captura en servidor.
SENTRY_DSN=

# VITE_SENTRY_DSN: DSN client-side de Sentry expuesto al navegador; vacio desactiva captura en cliente.
VITE_SENTRY_DSN=

# SENTRY_ENVIRONMENT: Nombre de entorno reportado por Sentry en servidor.
SENTRY_ENVIRONMENT=development

# VITE_SENTRY_ENVIRONMENT: Nombre de entorno reportado por Sentry en cliente.
VITE_SENTRY_ENVIRONMENT=development

# SENTRY_RELEASE: Version/release server-side para agrupar errores.
SENTRY_RELEASE=

# VITE_SENTRY_RELEASE: Version/release client-side para agrupar errores.
VITE_SENTRY_RELEASE=

# SENTRY_TRACES_SAMPLE_RATE: Porcentaje de trazas server-side; 0 evita overhead de performance tracing.
SENTRY_TRACES_SAMPLE_RATE=0.02

# VITE_SENTRY_TRACES_SAMPLE_RATE: Porcentaje de trazas client-side; 0 evita overhead en navegador.
VITE_SENTRY_TRACES_SAMPLE_RATE=0.02

# VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE: Porcentaje de sesiones grabadas por Replay; 0 lo desactiva.
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0

# VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE: Porcentaje de replays al ocurrir errores; 0 evita consumo adicional.
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1

# SENTRY_ENABLE_LOGS: Habilita envio de logs server-side a Sentry.
SENTRY_ENABLE_LOGS=false

# VITE_SENTRY_ENABLE_LOGS: Habilita envio de logs client-side a Sentry.
VITE_SENTRY_ENABLE_LOGS=false

# SENTRY_AUTH_TOKEN: Token privado para subir sourcemaps en build; nunca compartir ni commitear.
SENTRY_AUTH_TOKEN=

# SENTRY_ORG: Organizacion de Sentry usada para sourcemaps.
SENTRY_ORG=

# SENTRY_PROJECT: Proyecto de Sentry usado para sourcemaps.
SENTRY_PROJECT=

# BUILD_SENTRY_SOURCEMAPS: 1 habilita sourcemaps de Sentry en build; por defecto mantener 0 para no publicar mapas ni aumentar memoria.
BUILD_SENTRY_SOURCEMAPS=0

# BUILD_WORKER_SOURCEMAP: 1 genera sourcemap del worker local; mantener 0 en produccion.
BUILD_WORKER_SOURCEMAP=0

# -----------------------------------------------------------------------------
# ProductPulse billing and credits
# Configuracion comercial, puntos iniciales y precios en centavos.
# -----------------------------------------------------------------------------
# PRODUCT_PULSE_AI_LEVEL: Nivel interno de capacidades AI/producto habilitadas para ProductPulse.
PRODUCT_PULSE_AI_LEVEL=1

# PRODUCT_PULSE_INITIAL_STORE_POINTS: Creditos iniciales otorgados a una tienda nueva.
PRODUCT_PULSE_INITIAL_STORE_POINTS=10

# SHOPIFY_BILLING_TEST: Usa billing de prueba de Shopify; debe ser false en produccion real.
SHOPIFY_BILLING_TEST=true

# PRODUCT_PULSE_STARTER_PLAN_PRICE_CENTS: Precio del plan starter en centavos.
PRODUCT_PULSE_STARTER_PLAN_PRICE_CENTS=900

# PRODUCT_PULSE_STARTER_PLAN_COMPARE_AT_PRICE_CENTS: Precio tachado/comparativo del plan starter en centavos.
PRODUCT_PULSE_STARTER_PLAN_COMPARE_AT_PRICE_CENTS=1800

# PRODUCT_PULSE_CREDIT_PACK_10_PRICE_CENTS: Precio del paquete de 10 creditos en centavos.
PRODUCT_PULSE_CREDIT_PACK_10_PRICE_CENTS=300

# PRODUCT_PULSE_CREDIT_PACK_10_COMPARE_AT_PRICE_CENTS: Precio comparativo del paquete de 10 creditos.
PRODUCT_PULSE_CREDIT_PACK_10_COMPARE_AT_PRICE_CENTS=600

# PRODUCT_PULSE_CREDIT_PACK_25_PRICE_CENTS: Precio del paquete de 25 creditos en centavos.
PRODUCT_PULSE_CREDIT_PACK_25_PRICE_CENTS=650

# PRODUCT_PULSE_CREDIT_PACK_25_COMPARE_AT_PRICE_CENTS: Precio comparativo del paquete de 25 creditos.
PRODUCT_PULSE_CREDIT_PACK_25_COMPARE_AT_PRICE_CENTS=1300

# PRODUCT_PULSE_CREDIT_PACK_50_PRICE_CENTS: Precio del paquete de 50 creditos en centavos.
PRODUCT_PULSE_CREDIT_PACK_50_PRICE_CENTS=1100

# PRODUCT_PULSE_CREDIT_PACK_50_COMPARE_AT_PRICE_CENTS: Precio comparativo del paquete de 50 creditos.
PRODUCT_PULSE_CREDIT_PACK_50_COMPARE_AT_PRICE_CENTS=2200

# PRODUCT_PULSE_CREDIT_PACK_100_PRICE_CENTS: Precio del paquete de 100 creditos en centavos.
PRODUCT_PULSE_CREDIT_PACK_100_PRICE_CENTS=2100

# PRODUCT_PULSE_CREDIT_PACK_100_COMPARE_AT_PRICE_CENTS: Precio comparativo del paquete de 100 creditos.
PRODUCT_PULSE_CREDIT_PACK_100_COMPARE_AT_PRICE_CENTS=4200

# PRODUCT_PULSE_CREDIT_PACK_250_PRICE_CENTS: Precio del paquete de 250 creditos en centavos.
PRODUCT_PULSE_CREDIT_PACK_250_PRICE_CENTS=5000

# PRODUCT_PULSE_CREDIT_PACK_250_COMPARE_AT_PRICE_CENTS: Precio comparativo del paquete de 250 creditos.
PRODUCT_PULSE_CREDIT_PACK_250_COMPARE_AT_PRICE_CENTS=10000

# -----------------------------------------------------------------------------
# AI providers
# Credenciales y modelos base de proveedores AI.
# -----------------------------------------------------------------------------
# OPENAI_API_KEY: API key privada de OpenAI; necesaria para funciones AI basadas en OpenAI.
OPENAI_API_KEY=

# OPENAI_BASIC_MODEL: Modelo OpenAI economico usado como fallback barato.
OPENAI_BASIC_MODEL=gpt-5.4-nano

# OPENAI_PRO_MODEL: Modelo OpenAI principal para respuestas generales.
OPENAI_PRO_MODEL=gpt-5.4-mini

# OPENAI_PREMIUM_MODEL: Modelo OpenAI fuerte para tareas complejas.
OPENAI_PREMIUM_MODEL=gpt-5.4

# GEMINI_API_KEY: API key privada de Gemini si se usa proveedor Gemini.
GEMINI_API_KEY=

# GEMINI_MODEL: Modelo Gemini principal.
GEMINI_MODEL=

# GEMINI_MODEL_FALLBACK_POOL: Lista de modelos Gemini fallback separados por coma.
GEMINI_MODEL_FALLBACK_POOL=

# -----------------------------------------------------------------------------
# AI chat behavior
# Limites de contexto, tokens y acciones para mantener respuestas livianas.
# -----------------------------------------------------------------------------
# AI_ASSISTANT_ENABLED: Habilita o apaga el asistente AI completo.
AI_ASSISTANT_ENABLED=true

# AI_CHAT_MODEL: Modelo por defecto para chat AI.
AI_CHAT_MODEL=gpt-5.4-mini

# AI_CHAT_CHEAP_MODEL: Modelo barato para tareas simples o guardrails.
AI_CHAT_CHEAP_MODEL=gpt-5.4-nano

# AI_CHAT_STRONG_MODEL: Modelo fuerte opcional; si falta usa OPENAI_PREMIUM_MODEL.
AI_CHAT_STRONG_MODEL=gpt-5.4

# AI_CHAT_STANDARD_MONTHLY_MESSAGE_LIMIT: Limite mensual de mensajes para el plan standard.
AI_CHAT_STANDARD_MONTHLY_MESSAGE_LIMIT=30

# AI_CHAT_CHEAP_MONTHLY_MESSAGE_LIMIT: Limite mensual de mensajes baratos o fallback.
AI_CHAT_CHEAP_MONTHLY_MESSAGE_LIMIT=100

# AI_CHAT_MAX_TOOL_CALLS_PER_TURN: Maximo de herramientas por turno; bajo reduce CPU, memoria y llamadas externas.
AI_CHAT_MAX_TOOL_CALLS_PER_TURN=5

# AI_CHAT_MAX_RECENT_MESSAGES: Cantidad de mensajes recientes enviada al modelo; bajo reduce tokens y RAM.
AI_CHAT_MAX_RECENT_MESSAGES=8

# AI_CHAT_MAX_TOOL_RESULT_CHARACTERS: Caracteres maximos de resultados de herramientas incluidos en contexto.
AI_CHAT_MAX_TOOL_RESULT_CHARACTERS=6000

# AI_CHAT_MAX_OUTPUT_TOKENS: Tokens maximos de salida del modelo.
AI_CHAT_MAX_OUTPUT_TOKENS=1600

# AI_CHAT_MAX_STRUCTURED_RESPONSE_RETRIES: Reintentos para respuestas estructuradas; 0 evita trabajo duplicado.
AI_CHAT_MAX_STRUCTURED_RESPONSE_RETRIES=1

# AI_CHAT_MAX_ACTION_PROPOSALS_PER_TURN: Cantidad maxima de acciones propuestas por turno.
AI_CHAT_MAX_ACTION_PROPOSALS_PER_TURN=1

# AI_CHAT_OPENAI_TIMEOUT_MS: Timeout por request OpenAI para no acumular procesos esperando.
AI_CHAT_OPENAI_TIMEOUT_MS=30000

# AI_SCOPE_GUARD_ENABLED: Habilita guardrail de alcance antes de responder.
AI_SCOPE_GUARD_ENABLED=false

# AI_OUTPUT_GUARD_ENABLED: Habilita guardrail de salida cuando scope guard esta activo.
AI_OUTPUT_GUARD_ENABLED=true

# AI_SCOPE_GUARD_MODEL: Modelo usado por el guardrail de alcance.
AI_SCOPE_GUARD_MODEL=gpt-5.4-nano

# AI_SCOPE_GUARD_MAX_OUTPUT_TOKENS: Tokens maximos del guardrail de alcance.
AI_SCOPE_GUARD_MAX_OUTPUT_TOKENS=700

# AI_COST_TRACKING_ENABLED: Registra costos estimados de AI; puede desactivarse para reducir escrituras.
AI_COST_TRACKING_ENABLED=true

# AI_DEBUG_COSTS: Muestra logs de costos AI para debugging.
AI_DEBUG_COSTS=false

# AI_DEBUG_MODE: Activa logs/debug extra de AI; mantener false en produccion.
AI_DEBUG_MODE=false

# AI_COST_DASHBOARD_ENABLED: Habilita dashboard interno de costos AI.
AI_COST_DASHBOARD_ENABLED=false

# AI_EVAL_MODE: Modo evaluacion AI; mantener false fuera de pruebas.
AI_EVAL_MODE=false

# AI_MODEL_PRICING_JSON: JSON opcional con precios por modelo para calculo de costos.
AI_MODEL_PRICING_JSON=

# AI_CHATKIT_ENABLED: Habilita la experiencia ChatKit en frontend.
AI_CHATKIT_ENABLED=true

# AI_CHATKIT_API_URL: Endpoint backend usado por ChatKit para mensajes.
AI_CHATKIT_API_URL=/api/ai/chatkit/message

# AI_CHATKIT_DOMAIN_KEY: Clave publica de dominio ChatKit para el cliente.
AI_CHATKIT_DOMAIN_KEY=domain_pk_6a0e373140408193b67487c54e353dbd09dbeb51913073da

# AI_INTERNAL_ACTIONS_ENABLED: Permite que AI ejecute acciones internas; false reduce riesgo y carga.
AI_INTERNAL_ACTIONS_ENABLED=true

# AI_ACTION_CONFIRMATIONS_ENABLED: Exige confirmacion antes de acciones sensibles.
AI_ACTION_CONFIRMATIONS_ENABLED=true

# -----------------------------------------------------------------------------
# AI rate limits
# Limites por ventana para evitar rafagas de requests y proteger CPU/RAM.
# -----------------------------------------------------------------------------
# AI_RATE_LIMIT_ENABLED: Activa rate limiting de AI.
AI_RATE_LIMIT_ENABLED=true

# AI_RATE_LIMIT_WINDOW_MS: Ventana de rate limit en milisegundos.
AI_RATE_LIMIT_WINDOW_MS=60000

# AI_CHAT_RATE_LIMIT_PER_MINUTE: Requests de chat permitidos por minuto.
AI_CHAT_RATE_LIMIT_PER_MINUTE=20

# AI_ACTION_RATE_LIMIT_PER_MINUTE: Acciones AI permitidas por minuto.
AI_ACTION_RATE_LIMIT_PER_MINUTE=30

# AI_CHATKIT_SESSION_RATE_LIMIT_PER_MINUTE: Sesiones ChatKit permitidas por minuto.
AI_CHATKIT_SESSION_RATE_LIMIT_PER_MINUTE=60

# AI_CHATKIT_ACTION_RATE_LIMIT_PER_MINUTE: Acciones ChatKit permitidas por minuto.
AI_CHATKIT_ACTION_RATE_LIMIT_PER_MINUTE=60

# -----------------------------------------------------------------------------
# Beta feedback
# Feedback in-app opcional; desactivarlo evita polling y errores 401 en instalaciones sin sesion.
# -----------------------------------------------------------------------------
# PRODUCT_PULSE_BETA_FEEDBACK_ENABLED: Flag principal del modulo beta feedback.
PRODUCT_PULSE_BETA_FEEDBACK_ENABLED=true

# BETA_FEEDBACK_ENABLED: Flag legacy/fallback para beta feedback.
BETA_FEEDBACK_ENABLED=

# BETA_FEEDBACK_RECIPIENT: Email receptor de feedback; si falta puede usar CONTACT_EMAIL.
BETA_FEEDBACK_RECIPIENT=

# -----------------------------------------------------------------------------
# Watchlist cron
# Programacion y autorizacion del cron que encola diagnosticos de watchlist.
# -----------------------------------------------------------------------------
# PRODUCT_PULSE_WATCHLIST_CRON_TIME: Hora local programada para el cron en formato HH:mm.
PRODUCT_PULSE_WATCHLIST_CRON_TIME=03:00

# PRODUCT_PULSE_WATCHLIST_CRON_TIMEZONE: Timezone usado para interpretar la hora del cron.
PRODUCT_PULSE_WATCHLIST_CRON_TIMEZONE=UTC

# PRODUCT_PULSE_WATCHLIST_CRON_WINDOW_MINUTES: Ventana valida para aceptar ejecuciones alrededor de la hora configurada.
PRODUCT_PULSE_WATCHLIST_CRON_WINDOW_MINUTES=120

# PRODUCT_PULSE_WATCHLIST_CRON_LOCK_TTL_MINUTES: TTL del lock para impedir ejecuciones solapadas del cron.
PRODUCT_PULSE_WATCHLIST_CRON_LOCK_TTL_MINUTES=120

# PRODUCT_PULSE_WATCHLIST_CRON_SECRET: Secreto que debe enviar el cron para autorizar ejecucion en produccion.
PRODUCT_PULSE_WATCHLIST_CRON_SECRET=

# -----------------------------------------------------------------------------
# Background workers
# Control de jobs en background; valores conservadores priorizan estabilidad sobre velocidad.
# -----------------------------------------------------------------------------
# PRODUCT_PULSE_INLINE_WORKERS_ENABLED: Ejecuta workers dentro del proceso web; false separa carga y protege la UI.
PRODUCT_PULSE_INLINE_WORKERS_ENABLED=true

# PRODUCT_PULSE_JOB_LEASE_TTL_MS: Duracion del lease de un job antes de considerarlo recuperable.
PRODUCT_PULSE_JOB_LEASE_TTL_MS=600000

# PRODUCT_PULSE_JOB_HEARTBEAT_MS: Frecuencia con la que un worker renueva estado de job.
PRODUCT_PULSE_JOB_HEARTBEAT_MS=60000

# PRODUCT_PULSE_WORKER_IDLE_SLEEP_MS: Pausa entre ciclos cuando no hay trabajo; mas alto reduce CPU.
PRODUCT_PULSE_WORKER_IDLE_SLEEP_MS=5000

# PRODUCT_PULSE_WORKER_MAX_JOBS_PER_CYCLE: Jobs procesados por ciclo; 1 fuerza procesamiento serial liviano.
PRODUCT_PULSE_WORKER_MAX_JOBS_PER_CYCLE=1

# -----------------------------------------------------------------------------
# Catalog Scan performance
# Controla como Catalog Scan lee Shopify y cuanto espera antes de completar.
# -----------------------------------------------------------------------------
# PRODUCT_PULSE_QUICK_SCAN_MINIMUM_DURATION_MS: Delay artificial minimo del scan; 0 evita esperas innecesarias.
PRODUCT_PULSE_QUICK_SCAN_MINIMUM_DURATION_MS=0

# PRODUCT_PULSE_QUICK_SCAN_EXTRACTION_MODE: auto usa paginado en catalogos chicos y bulk en catalogos grandes; valores: auto, paginated, bulk.
PRODUCT_PULSE_QUICK_SCAN_EXTRACTION_MODE=auto

# PRODUCT_PULSE_QUICK_SCAN_PAGINATED_AUTO_PRODUCT_LIMIT: En modo auto, hasta esta cantidad de productos usa consultas paginadas de baja latencia.
PRODUCT_PULSE_QUICK_SCAN_PAGINATED_AUTO_PRODUCT_LIMIT=250

# PRODUCT_PULSE_QUICK_SCAN_PAGINATED_AUTO_ORDER_LIMIT: En modo auto, hasta esta cantidad de ordenes recientes usa paginado; por encima usa bulk.
PRODUCT_PULSE_QUICK_SCAN_PAGINATED_AUTO_ORDER_LIMIT=150

# PRODUCT_PULSE_QUICK_SCAN_BULK_POLL_INTERVAL_MS: Frecuencia para consultar estado de bulk operations de Shopify.
PRODUCT_PULSE_QUICK_SCAN_BULK_POLL_INTERVAL_MS=1000

# PRODUCT_PULSE_QUICK_SCAN_PRODUCT_COUNT_TIMEOUT_MS: Timeout corto para decidir modo auto; si falla, usa bulk.
PRODUCT_PULSE_QUICK_SCAN_PRODUCT_COUNT_TIMEOUT_MS=2500

# PRODUCT_PULSE_QUICK_SCAN_ORDER_COUNT_TIMEOUT_MS: Timeout corto para contar ordenes recientes en modo auto.
PRODUCT_PULSE_QUICK_SCAN_ORDER_COUNT_TIMEOUT_MS=2500

# PRODUCT_PULSE_QUICK_SCAN_PROGRESS_LOG_INTERVAL_MS: Cada cuanto imprime progreso durante bulk polling y parseo largo.
PRODUCT_PULSE_QUICK_SCAN_PROGRESS_LOG_INTERVAL_MS=5000

# PRODUCT_PULSE_QUICK_SCAN_MAX_PAGINATED_PAGES: Corte defensivo para evitar loops si Shopify devuelve cursores sin avance.
PRODUCT_PULSE_QUICK_SCAN_MAX_PAGINATED_PAGES=1000

# -----------------------------------------------------------------------------
# Dashboard cache
# Cache corta en memoria para evitar recalcular el dashboard en navegaciones repetidas.
# -----------------------------------------------------------------------------
# PRODUCT_PULSE_DASHBOARD_CACHE_TTL_MS: Tiempo maximo de cache por shop; 15000 evita recalculos sin ocultar cambios mucho tiempo.
PRODUCT_PULSE_DASHBOARD_CACHE_TTL_MS=15000

# PRODUCT_PULSE_DASHBOARD_ACTIVE_JOB_CACHE_TTL_MS: TTL cuando hay jobs activos; mas bajo muestra cambios de estado rapido.
PRODUCT_PULSE_DASHBOARD_ACTIVE_JOB_CACHE_TTL_MS=5000

# PRODUCT_PULSE_DASHBOARD_CACHE_MAX_SHOPS: Cantidad maxima de shops cacheadas en memoria por proceso.
PRODUCT_PULSE_DASHBOARD_CACHE_MAX_SHOPS=25

# -----------------------------------------------------------------------------
# Retention analysis limits
# Tamano de paginas Shopify para analisis de retencion; mas bajo consume menos memoria.
# -----------------------------------------------------------------------------
# PRODUCT_RETENTION_ORDER_PAGE_SIZE: Ordenes solicitadas por pagina a Shopify.
PRODUCT_RETENTION_ORDER_PAGE_SIZE=50

# PRODUCT_RETENTION_MAX_ORDER_PAGES: Cantidad maxima de paginas de ordenes por corrida.
PRODUCT_RETENTION_MAX_ORDER_PAGES=80

# PRODUCT_RETENTION_LINE_ITEMS_PAGE_SIZE: Line items solicitados por pagina dentro de cada orden.
PRODUCT_RETENTION_LINE_ITEMS_PAGE_SIZE=100

# PRODUCT_RETENTION_REFUND_LINE_ITEMS_PAGE_SIZE: Refund line items solicitados por pagina dentro de cada orden.
PRODUCT_RETENTION_REFUND_LINE_ITEMS_PAGE_SIZE=100
